WATCHER_PORT=8000
WATCHER_ORIGIN=
WATCHER_DASHBOARD_URL=
SOURCE_SPACING_SECONDS=2
WORKER_TIMEOUT_SECONDS=12
RETENTION_DAYS=90

# Empty disables the alert endpoint. Generate with python3 -c 'import secrets; print(secrets.token_urlsafe(32))'.
INGESTION_SECRET=
# Set both to enable Telegram. Leave both empty to log notifications locally.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Listing assistant. "fixture" is a deterministic offline responder (not an AI model, no cost).
# "none" disables chat; listing details, notes and drafts keep working. No cloud provider is implemented.
ASSISTANT_PROVIDER=fixture
ASSISTANT_TIMEOUT_SECONDS=60
